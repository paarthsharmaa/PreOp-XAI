# Patient-level data and run outputs stay local. Only data/README.md is tracked.
/data/*
!/data/README.md
/outputs/

# Fitted models and the MOVER SHAP background stay local.
/artifacts/

# Earlier local working copy with patient-level tables and runs.
/MOVER/

# Patient-level artifact types, wherever they appear.
*.pkl
*.pickle
*.npz
*.npy
mover_analysis*.csv
predictions*.csv

# Python and tooling.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
core
core.*

# Dashboard build output.
node_modules/
/app/web/dist/
/app/web/public/data/
/app/web/test-results/
/app/web/playwright-report/
