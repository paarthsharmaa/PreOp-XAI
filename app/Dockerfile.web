FROM python:3.13-slim AS data
WORKDIR /srv
COPY app/__init__.py app/build_data.py app/
COPY pipeline/__init__.py pipeline/config.py pipeline/
COPY config/paths.toml config/
COPY results results
COPY verification verification
RUN python -m app.build_data

FROM node:24-slim AS build
WORKDIR /web
COPY app/web/package.json app/web/package-lock.json ./
RUN npm ci
COPY app/web/ ./
COPY --from=data /srv/app/web/public/data public/data
RUN npm run build

FROM nginx:1.29-alpine
COPY app/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
