# Model artifacts and VitalDB are mounted read-only at run time and are never copied into the image.
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY .python-version pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --group app
COPY app/__init__.py app/
COPY app/api app/api
COPY config/paths.toml config/
COPY data_prep data_prep
COPY pipeline pipeline
COPY src src
COPY results/cohort/mover_feature_stats.json results/cohort/
ENV PREOPXAI_ARTIFACTS=/srv/artifacts PREOPXAI_VITALDB_CLINICAL=/srv/data/vitaldb/vitaldb_cases.csv \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MPLBACKEND=Agg MPLCONFIGDIR=/tmp/matplotlib
USER 1000:1000
EXPOSE 8000
CMD [".venv/bin/uvicorn", "app.api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
